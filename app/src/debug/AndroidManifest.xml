<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!--
      V3 탐사 전용(디버그 빌드만): CarPropertyManager로 기어를 읽으려면 이 권한이 필요하다(실측, FINDINGS V3).
      기본 판정은 Vehicle SDK의 Gear(권한 CAR_DRIVE)라서 release 매니페스트에는 선언하지 않는다.
      권한을 승인받지 못한 앱은 심사에서 떨어질 수 있으므로(계획서 1.3) 쓰지 않는 권한은 넣지 않는 원칙을 따른다.
    -->
    <uses-permission android:name="android.car.permission.CAR_POWERTRAIN" />
</manifest>
